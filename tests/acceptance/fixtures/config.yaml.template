last_receipt_number: 10

anthropic_api_key: ${ANTHROPIC_API_KEY}

mixed_vat_label: "gemischt"
decimal_separator: ","
ig_vat_rate: 20
default_einnahmen_category: "Waren-/Leistungserlöse"
default_ausgaben_category: "sonstige Betriebsausgaben"

own_company_names:
  - J. Muster, IT-Dienstleistungen
  - J. Muster

category_rules:
  NetConnect Austria: "Telefon/Internet"

business_percentage_rules:
  NetConnect Austria: 66.67
  Stadtgemeinde Waldbach: 9.2154

position_business_rules:
  "Stadtgemeinde Waldbach":
    business_keywords:
      - "Grundsteuer"
      - "Kanal"
      - "Seuchenvorsorge"
      - "Abfallwirtschaft"

original_journal:
  path: "/workdir/before.xlsx"
  sheet: "Journal"
  permanent_merged_dir: "/workdir/permanent_merged"
  columns:                        # maps our field names → your Excel column headers; omit a line to skip that field
    year: "Jahr"
    receipt_number: "Belegnummer"
    category: "Buchungstyp"
    detail_category: "Kategorie"
    payment_date: "Buchungsdatum"
    counterparty: "Auftraggeber/Empfänger"
    # col7: ""                    # always-empty spacer column; omit if not present
    # weiterverkauf: ""           # always-empty; omit if not present
    afa: "AfA"
    gross_eur: "Brutto EUR"
    gross_anteilig: "Brutto antlg."
    anteil_pct: "Anteil"
    vat_pct: "USt %"
    vat_eur: "USt EUR"
    vat_anteilig: "USt antlg."
    net_eur: "Netto EUR"
    net_anteilig: "Netto antlg."
    vat_deadline: "UVA Frist"
    ig: "IG"
    # est_betrag: ""              # always-empty; omit if not present
    ig_vat_anteilig: "IG USt antlg."
    invoice_filename: "Eingangsrechnung"
    payment_filename: "Bankbeleg"

fetcher:
  filesystem_sources:
    - label: "test_invoices"
      path: "/workdir/invoice_sources"
      recursive: false
      since_days: 365
      filter_by_mtime: false
