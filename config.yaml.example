anthropic_api_key: sk-ant-...

mixed_vat_label: "gemischt"
decimal_separator: ","
ig_vat_rate: 20
default_einnahmen_category: "Waren-/Leistungserlöse"
default_ausgaben_category: "sonstige Betriebsausgaben"

own_company_names:
  - MyCompany GmbH
  - Jane Doe

# keyword → detail category (substring match on counterparty name)
category_rules:
  Provider AG: "Telefon/Internet"
  SoftwareCo: "Lizenzgebühren"
  Insurance Ltd: "Pflichtversicherungsbeiträge"

# keyword → % of expense that is business use (substring match on counterparty name)
business_percentage_rules:
  Provider AG: 66.67
  Landlord GmbH: 25

# keyword → list of keywords that mark a position as business use
# Positions not matching any business_keyword are treated as private.
# The business_percentage for the invoice is computed from the position gross amounts.
# An overview page "Berechnung des abzugsfähigen Anteils" is inserted into the merged PDF.
position_business_rules:
  "Municipality Name":
    business_keywords: ["Office", "Business"]

original_journal:
  path: "~/Documents/Buchhaltung/Journal.xlsx"   # full path to the Excel journal workbook
  sheet: "Journal"                                # worksheet name
  payment_date_column: "Buchungsdatum"            # column header for booking/payment date
  year_column: "Jahr"                             # column header for the year (integer)
  receipt_number_column: "Belegnummer"            # column header for receipt number (integer, unique per year)
  permanent_merged_dir: "~/Documents/Buchhaltung/Belege"  # archive of all merged PDFs (for cross-check)

fetcher:
  gmail_sources:
    - label: "office"           # human-readable name used in logs and --only filter
      username: office@example.com
      client_secret_file: "~/.config/fibutool/client_secret_office.json"  # downloaded from Google Cloud Console
      token_file: "~/.config/fibutool/token_office.json"                  # created by fetcher on first run
      folders:
        - INBOX
      filters:                  # AND-combined; omit a list to accept any value
        senders:                # substring match on From: header
          - "@supplier.com"
        subject_keywords:       # substring match on Subject: header (case-insensitive)
          - "Rechnung"
          - "Invoice"
          - "Gutschrift"

  filesystem_sources:
    - label: "outgoing"         # own outgoing invoices exported to a local folder
      path: "~/Documents/invoices/outgoing"
      recursive: false          # set true to walk subdirectories
      filename_patterns:        # glob patterns (default: ["*.pdf"])
        - "*.pdf"
      filter_by_mtime: true     # skip files older than --since (default: true)

  imap_sources:
    - label: "mail"             # human-readable name used in logs and --only filter
      host: mail.example.com    # IMAP server hostname
      port: 993                 # IMAP SSL port (default: 993)
      username: office@example.com
      # password stored in OS keyring (service "fibutool-fetcher", key "<label>:<username>")
      # fetcher prompts on first run and stores after successful login
      folders:
        - INBOX
      filters:                  # AND-combined; omit a list to accept any value
        senders:                # substring match on From: header (client-side)
          - "@supplier.com"
        subject_keywords:       # substring match on Subject: header (case-insensitive)
          - "Rechnung"
          - "Invoice"
          - "Gutschrift"
