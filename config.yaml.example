anthropic_api_key: sk-ant-...

mixed_vat_label: "gemischt"
decimal_separator: ","
ig_vat_rate: 20
default_einnahmen_category: "Waren-/Leistungserlöse"
default_ausgaben_category: "sonstige Betriebsausgaben"

own_company_names:
  - MyCompany GmbH
  - Jane Doe

# keyword → detail category (substring match on counterparty name)
category_rules:
  Provider AG: "Telefon/Internet"
  SoftwareCo: "Lizenzgebühren"
  Insurance Ltd: "Pflichtversicherungsbeiträge"

# keyword → % of expense that is business use (substring match on counterparty name)
business_percentage_rules:
  Provider AG: 66.67
  Landlord GmbH: 25

# keyword → list of keywords that mark a position as business use
# Positions not matching any business_keyword are treated as private.
# The business_percentage for the invoice is computed from the position gross amounts.
# An overview page "Berechnung des abzugsfähigen Anteils" is inserted into the merged PDF.
position_business_rules:
  "Municipality Name":
    business_keywords: ["Office", "Business"]

fetcher:
  since: "2026-01-01"          # skip messages received before this date (overridable via --since)

  gmail_sources:
    - label: "office"           # human-readable name used in logs and --only filter
      username: office@example.com
      client_secret_file: "~/.config/fibutool/client_secret_office.json"  # downloaded from Google Cloud Console
      token_file: "~/.config/fibutool/token_office.json"                  # created by fetcher on first run
      folders:
        - INBOX
      filters:                  # AND-combined; omit a list to accept any value
        senders:                # substring match on From: header
          - "@supplier.com"
        subject_keywords:       # substring match on Subject: header (case-insensitive)
          - "Rechnung"
          - "Invoice"
          - "Gutschrift"
